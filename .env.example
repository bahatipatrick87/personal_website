# Public site URL — use full URL with https:// (no trailing slash).
# On Vercel, set this to https://YOUR-PROJECT.vercel.app or your custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Database (contact-form storage) --------------------------------------
# Postgres connection string. On Vercel: Project → Storage → Create Database
# → Postgres, then "Connect to Project" — this env var is added for you
# automatically. Locally, point it at any Postgres instance (a free Neon
# branch works well: https://neon.tech).
# Every message submitted through /contact is saved here permanently and
# viewable at /admin, regardless of whether email delivery (below) works.
POSTGRES_URL=

# --- Admin dashboard (/admin) ----------------------------------------------
# Protects the /admin inbox with HTTP Basic Auth. Required to view messages.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Email notifications (optional, via Resend) ----------------------------
# https://resend.com (free tier: 3,000 emails/month). If set, every contact
# form message is also emailed to CONTACT_TO_EMAIL. If unset, messages are
# still saved to the database above and visible at /admin — email is a bonus,
# not a requirement.
RESEND_API_KEY=

# Where contact-form messages are emailed. Defaults to bahatipatrick87@gmail.com if unset.
CONTACT_TO_EMAIL=bahatipatrick87@gmail.com

# Sender identity used on outgoing emails. The Resend sandbox address below works
# out of the box with no domain setup, as long as CONTACT_TO_EMAIL is the same
# address you signed up to Resend with. Verify your own domain in Resend to send
# from e.g. "Portfolio Contact <contact@yourdomain.com>" instead.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
