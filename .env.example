# Public site URL (Open Graph, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Clerk — https://dashboard.clerk.com
# Visitors do NOT need an account to use your portfolio. Clerk is only for the
# optional /dashboard area and the header "Sign in" button.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: limit /dashboard to specific Clerk user IDs (comma-separated).
# Does NOT affect public pages. If unset, any signed-in user can open /dashboard.
# DASHBOARD_ALLOWED_USER_IDS=user_xxxxxxxxxxxxxxxxxxxxxxxx
